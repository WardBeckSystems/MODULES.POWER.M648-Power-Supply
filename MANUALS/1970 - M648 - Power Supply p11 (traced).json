   {"mm": [42.1, 79.5, 72.1, 85.9], "text": "and zener"},
   {"mm": [73.8, 78.2, 162.4, 85.8], "text": "diode CR3. If for any reason"},
   {"mm": [164.1, 77.5, 285.0, 85.9], "text": "the output voltage rises above +56 volts,"},
   {"mm": [42.1, 71.7, 98.5, 79.9], "text": "CR3 will begin to"},
   {"mm": [205.8, 70.4, 277.2, 80.0], "text": "CR4 causing it to fire:"},
